// Secrets, set with `npx wrangler secret put NAME`. One prefix per route family.
//
//   RESEND_API_KEY             from resend.com. Full access: /confirm writes a
//                              Contact and /send creates a Broadcast, and a
//                              sending-only key refuses both with
//                              restricted_api_key (401). Sending access alone
//                              covers /contact and /subscribe.
//   RESEND_FROM                a verified sender on that account
//   RESEND_SEGMENT_ID          dashboard: Audience -> Segments. Contacts are
//                              global and can sit in several Segments; a
//                              Broadcast targets one of them.
//   CONTACT_TO                 where /contact notes land
//   SUBSCRIBE_SIGNING_KEY      HMAC key for /confirm links
//   BROADCAST_PASSWORD         guards /compose and /send
//   BROADCAST_POSTAL_ADDRESS   CAN-SPAM footer; leave unset to keep /send off
//
// Generate the two random ones: openssl rand -base64 24
//
// Regenerate binding types after editing this file:
//   npx wrangler types --include-runtime false
// Then drop the Cloudflare.GlobalProps block from src/worker/worker-configuration.d.ts
// unless the entry only exports `default`.
// One Worker on one account: Paula's. There is no staging Worker and no
// `env` block. Check a change before it is live by uploading a version
// without deploying it. It runs on the real bindings, at a public URL:
//   npx wrangler versions upload --preview-alias next
//   npx wrangler versions deploy        # promote it
//   npx wrangler rollback               # undo
{
  "name": "hotstuff",
  "account_id": "90f3dbd0e159495e8bc15718edb11e20",
  // Custom entry: mail + /data + scheduled, then Astro's handle for HTML.
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true
  },
  // Both default to true, and a deploy applies the default when the key is
  // absent — so the dashboard toggles for these cannot be turned off by hand
  // and stay off. Stated here, the repo is the one place that decides.
  //   workers_dev   the fallback hostname, for when the custom domain is the
  //                 thing that is broken
  //   preview_urls  `wrangler versions upload` serves at <alias>-hotstuff...,
  //                 which is how a change is checked before it is live.
  //                 Public: anyone with the link can load one.
  "workers_dev": true,
  "preview_urls": true,
  // Astro 7 puts copied public/ files in dist/client (server bundle is
  // dist/server). Wrangler Static Assets must point at the client tree so
  // _headers and CSS/images are served without invoking the Worker.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  // No preview_id: `wrangler dev` simulates KV on disk rather than reading a
  // namespace, so local runs need nothing here.
  "kv_namespaces": [
    {
      "binding": "CATALOG",
      "id": "6fa148702b0647d2b7c8b8db935e7796"
    }
  ],
  // Custom event counts (asks, successful mail, …). Dataset is account-scoped
  // (SQL table name), so prefix with the project — same idea as hotstuff-catalog.
  // It is created by the first write, not by anything here.
  //   SELECT blob1 AS event, blob2 AS detail, SUM(_sample_interval) AS n
  //   FROM "hotstuff-metrics" WHERE timestamp > NOW() - INTERVAL '30' DAY
  //   GROUP BY event, detail ORDER BY n DESC
  "analytics_engine_datasets": [
    { "binding": "METRICS", "dataset": "hotstuff-metrics" }
  ],
  // The deployed version id, which changes on every deploy. It is half of the
  // HTML cache key: the catalog generation retires entries when the sheet
  // changes, and this retires them when the code does. Without it a copy edit
  // ships correctly and then waits out the previous entry's hour.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": ["13 * * * *"]
  },
  "vars": {
    "PRODUCTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=685501268&single=true&output=csv",
    "EVENTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=1952117961&single=true&output=csv",
    // Both optional: the tabs are published but empty most of the time, and
    // no rows is a success, not an error. Blank them to turn a feature off.
    "ANNOUNCEMENTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=619153325&single=true&output=csv",
    "VIDEOS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=398538387&single=true&output=csv"
  },
  "ratelimits": [
    {
      "name": "MAIL_IP",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "MAIL_EMAIL",
      "namespace_id": "1002",
      "simple": { "limit": 1, "period": 60 }
    },
    {
      "name": "SEND_IP",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Worker Previews: per-branch deployments of this same Worker, created with
  // `npx wrangler preview`, for changes the owners need to click before they
  // are live. Nothing here is inherited from above — a preview gets only what
  // this block names — so the bindings are repeated rather than extended.
  //
  //   npx wrangler preview                      deploy the current branch
  //   npx wrangler preview secret put NAME      a secret for this branch only
  //   npx wrangler preview base-config secret   a secret every preview gets
  //   npx wrangler preview delete --name NAME   remove it
  //
  // Two things previews do not get: cron triggers and routes both target
  // production, so a preview's KV stays empty until something asks for /data,
  // and a preview is only ever reachable on workers.dev, never the domain.
  // Preview URLs are public.
  "previews": {
    // A namespace of its own. Omit this and a preview writes the live catalog.
    "kv_namespaces": [
      {
        "binding": "CATALOG",
        "id": "2f67a8dedf2e4cb2ba6a239d38610ad8"
      }
    ],
    // Test traffic stays out of the numbers Paula and John would read.
    "analytics_engine_datasets": [
      { "binding": "METRICS", "dataset": "hotstuff-metrics-preview" }
    ],
    "version_metadata": {
      "binding": "CF_VERSION_METADATA"
    },
    // The live sheet for now, because it is public and read-only. Point these
    // at a copy when there is one: the reason to have a second spreadsheet is
    // to type bad data into it on purpose and watch what the page does.
    "vars": {
      "PRODUCTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=685501268&single=true&output=csv",
      "EVENTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=1952117961&single=true&output=csv",
      "ANNOUNCEMENTS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=619153325&single=true&output=csv",
      "VIDEOS_CSV_URL": "https://docs.google.com/spreadsheets/d/e/2PACX-1vThGdNSBT7_ydyWCHyQUuvYu8gBaow8xgqiLPkyAAmT1AcVnCe0ttgpdvqIlA0rp7UGs-uQL-Sx4k3z/pub?gid=398538387&single=true&output=csv"
    },
    // Counters are shared by id across Workers, so these must not reuse the
    // production ids: a preview URL is public, and sharing 1001-1003 would let
    // anyone's POSTs to a preview rate-limit the live forms.
    "ratelimits": [
      {
        "name": "MAIL_IP",
        "namespace_id": "2001",
        "simple": { "limit": 3, "period": 60 }
      },
      {
        "name": "MAIL_EMAIL",
        "namespace_id": "2002",
        "simple": { "limit": 1, "period": 60 }
      },
      {
        "name": "SEND_IP",
        "namespace_id": "2003",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
