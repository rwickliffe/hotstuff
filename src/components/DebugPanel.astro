---
interface Source {
  state: string;
  rows?: number | null;
  note?: string;
}

interface Props {
  products: Source;
  events: Source;
  worker: Source;
}

const { products, events, worker } = Astro.props;

function tone(state: string) {
  return /^live/.test(state) || state === "same-origin" ? "#5CB84A" : "#E8A87C";
}

function rows(source: Source) {
  return source.rows != null ? ` (${source.rows} rows)` : "";
}
---
<div
  id="diag"
  style="position:fixed;right:12px;bottom:12px;z-index:9999;max-width:340px;background:#14100E;color:#F0E7DC;border:1px solid #46392F;border-radius:4px;padding:12px 14px;font:12px/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;box-shadow:0 6px 24px rgba(0,0,0,.4)"
>
  <div style="color:#B0A296">data sources</div>
  <div style="margin-top:6px">
    <b>products</b>{" "}
    <span style={`color:${tone(products.state)}`}>{products.state}</span>
    {rows(products)}
    {products.note ? (
      <div style="color:#B0A296;margin-top:2px">{products.note}</div>
    ) : null}
  </div>
  <div style="margin-top:6px">
    <b>events</b>{" "}
    <span style={`color:${tone(events.state)}`}>{events.state}</span>
    {rows(events)}
    {events.note ? (
      <div style="color:#B0A296;margin-top:2px">{events.note}</div>
    ) : null}
  </div>
  <div style="margin-top:6px">
    <b>worker</b>{" "}
    <span id="diag-worker">
      <span style={`color:${tone(worker.state)}`}>{worker.state}</span>
      {worker.note ? (
        <div style="color:#B0A296;margin-top:2px">{worker.note}</div>
      ) : null}
    </span>
  </div>
</div>
