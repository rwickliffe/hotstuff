---
import { normalizeDay, parseDay } from "../lib/csv.js";
import { shortMonth, shortWeekday } from "../lib/date-format.ts";
import { calendarDay } from "../lib/timezone.ts";
import { MARKET_TZ } from "../site-config.ts";

interface Props {
  events: Record<string, string>[];
}

const today = calendarDay(new Date(), MARKET_TZ);

const upcoming = Astro.props.events
  .map((row) => ({ row, day: normalizeDay(row.date) }))
  .filter(
    (e): e is { row: Record<string, string>; day: string } =>
      e.day !== null && e.day >= today,
  )
  .sort((a, b) => a.day.localeCompare(b.day))
  .slice(0, 30)
  .map((e) => ({ row: e.row, when: parseDay(e.day)! }));
---

<div id="cal-rows">
  {upcoming.length === 0 ? (
    <p class="cal-empty">
      Nothing on the books right now.{" "}
      <a href="https://www.facebook.com/paulassalsa">Facebook</a> has the
      latest.
    </p>
  ) : (
    upcoming.map((e) => (
      <div class="cal-row">
        <span class="cal-when">
          {shortWeekday(e.when)} {e.when.getDate()} {shortMonth(e.when)}
        </span>
        <span class="cal-what">
          {e.row.name || ""}
          {e.row.time ? <small>{e.row.time}</small> : null}
          {e.row.address ? (
            <a
              class="cal-map"
              href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(e.row.address)}`}
            >
              {e.row.address}
            </a>
          ) : null}
        </span>
      </div>
    ))
  )}
</div>
