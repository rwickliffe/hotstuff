---
export const prerender = false;

import { env } from "cloudflare:workers";
import Base from "../layouts/Base.astro";
import DebugPanel from "../components/DebugPanel.astro";
import HeatLegend from "../components/HeatLegend.astro";
import ProductCard from "../components/ProductCard.astro";
import Schedule from "../components/Schedule.astro";
import { dataAge, debugSources, gridFor, isDebug } from "../lib/page-catalog.ts";
import { readCatalog } from "../worker/catalog.ts";

const catalog = await readCatalog(env);
const paula = gridFor(catalog.products, "Paula", true);
const john = gridFor(catalog.products, "John", true);
const age = dataAge(catalog.fetchedAt);
const debug = isDebug(Astro.url);
---
<Base>
  {debug && <DebugPanel {...debugSources(catalog)} />}

  <main>
    <header class="hero">
      <div class="hero-media">
        <img
          src="/images/lineup.jpg"
          width="1600"
          height="1200"
          fetchpriority="high"
          decoding="async"
          alt="The full lineup of Paula and Crazy John's hot sauces, salsas, cowboy candy and pickles on a deck table"
        />
      </div>
      <div class="hero-inner">
        <img
          class="hero-logo"
          src="/images/logo.jpg"
          width="560"
          height="558"
          decoding="async"
          alt="Paula and Crazy John's Hot Stuff logo"
        />
        <p class="hero-place">Homemade in Elgin, Texas</p>
        <h1>Home grown. <em>Hand jarred. No survivors.</em></h1>
        <p class="hero-sub">
          Small-batch salsa, hot sauce, cowboy candy, pickles and chow chow.
          Everything grown out back, everything put up by hand, in a kitchen you
          would not want to walk into unannounced.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#order">Order Online</a>
          <a class="btn btn-ghost" href="#find">Find The Booth</a>
        </div>
      </div>
    </header>

    <div class="strip">
      <ul>
        <li><b>Salsa</b><span>Mild to unholy</span></li>
        <li><b>Hot Sauce</b><span>More than is wise</span></li>
        <li><b>Cowboy Candy</b><span>Candied jalapeños</span></li>
        <li><b>Pickles</b><span>Dill &amp; bread'n'butter</span></li>
        <li><b>Chow Chow</b><span>The old way</span></li>
        <li><b>More!</b><span>Ask, if you're brave</span></li>
      </ul>
    </div>

    <section id="jars">
      <div class="shell">
        <div class="sec-head">
          <p class="eyebrow maker">Paula's</p>
          <h2>Salsas, pickles, cowboy candy &amp; more</h2>
          <div class="lede-row">
            <p class="lede">
              Paula's side of the table. Same garden, gentler intentions. Mostly.
            </p>
            <svg
              class="flourish flourish-blade"
              viewBox="0 0 84 56"
              aria-hidden="true"
              focusable="false"
            >
              <path class="edge" d="M8 9 H48 V37 C35 45 21 45 8 37 Z"></path>
              <circle class="hole" cx="15" cy="17" r="3"></circle>
              <path class="grip" d="M52 25 H76"></path>
            </svg>
          </div>
          <span class="snapshot snapshot-sm">
            <span class="snapshot-paper">
              <img
                src="/images/paula-pickles.jpg"
                width="520"
                height="309"
                loading="lazy"
                decoding="async"
                alt="Jars of Paula's dill pickles fresh from the kitchen, cucumber, onion, dill and a red pepper in the brine"
              />
            </span>
          </span>
        </div>
        <div class="grid" data-grid="Paula" data-featured>
          {paula.map((p) => <ProductCard product={p} />)}
        </div>
        <p class="see-all-row">
          <a class="see-all" href="/products#paula">See all of Paula's</a>
        </p>
      </div>
    </section>

    <section id="sauces" style="background: var(--paper-sunk);">
      <div class="shell">
        <div class="sec-head">
          <p class="eyebrow maker">Crazy John's</p>
          <h2>The hot sauces</h2>
          <div class="lede-row">
            <p class="lede">
              Crazy John builds these one small batch at a time, out in the shed,
              and they climb from friendly to genuinely reckless. The rating is
              his own, it goes well past the reaper, and he does not grade on a
              curve.
            </p>
            <svg
              class="flourish flourish-blade"
              viewBox="0 0 84 56"
              aria-hidden="true"
              focusable="false"
            >
              <path class="edge" d="M53 8 C38 6 18 12 6 26 C20 18 38 16 52 18 Z"></path>
              <path class="haft" d="M52 12 L60 52"></path>
              <path class="haft" d="M56 34 L68 29"></path>
            </svg>
          </div>
          <span class="snapshot snapshot-sm">
            <span class="snapshot-paper">
              <img
                src="/images/john-bottles.jpg"
                width="520"
                height="296"
                loading="lazy"
                decoding="async"
                alt="Bottles of Crazy John's ultra insanity sauces on the market table"
              />
            </span>
          </span>
        </div>

        <HeatLegend />

        <div class="grid" data-grid="John" data-featured>
          {john.map((p) => <ProductCard product={p} />)}
        </div>
        <p class="see-all-row">
          <a class="see-all" href="/products#john">See all of Crazy John's</a>
        </p>
        <p class="data-age" id="data-age" hidden={age.hidden || undefined}>{age.text}</p>
      </div>
    </section>

    <section class="pricing" id="order">
      <div class="shell">
        <div class="sec-head">
          <p class="eyebrow">
            What it costs<svg
              class="flourish flourish-spatter"
              viewBox="0 0 58 24"
              aria-hidden="true"
              focusable="false"
            >
              <g class="drop">
                <path d="M20 5 C26 2 33 4 34 9 C35 15 30 19 24 18 C17 17 13 12 15 8 C16 6 18 5 20 5 Z"></path>
                <path d="M38 6 C41 5 44 7 43 10 C42 13 38 13 37 10 C36 8 37 6 38 6 Z"></path>
                <circle cx="9" cy="4" r="2.1"></circle>
                <circle cx="6" cy="14" r="1.5"></circle>
                <circle cx="12" cy="20" r="1.2"></circle>
                <circle cx="30" cy="21" r="1.6"></circle>
                <circle cx="47" cy="16" r="2.3"></circle>
                <circle cx="52" cy="7" r="1.4"></circle>
                <circle cx="56" cy="19" r="1"></circle>
                <circle cx="42" cy="2" r="1.1"></circle>
              </g>
            </svg>
          </p>
          <h2>Buy one, or buy three</h2>
          <p class="lede">Same prices at the booth and online.</p>
        </div>

        <div class="deals">
          <div class="deal">
            <span class="deal-what">Pints &amp; hot sauce</span>
            <span class="deal-single">$10</span>
            <span class="deal-bulk">3 for $25</span>
            <span class="deal-note">
              Salsas, cowboy candy, pickles and every one of Crazy John's sauces.
            </span>
          </div>
          <div class="deal">
            <span class="deal-what">Quarts</span>
            <span class="deal-single">$15</span>
            <span class="deal-bulk">3 for $40</span>
            <span class="deal-note">For bigger hot stuff.</span>
          </div>
          <div class="deal" style="border-top-color: var(--flame);">
            <span class="deal-what">Pick up</span>
            <span class="deal-single">Free</span>
            <span class="deal-bulk">At the market, or in Elgin</span>
            <span class="deal-note">
              Order online, then grab it from us at the next market. No shipping
              to worry about.
            </span>
          </div>
        </div>

        <div class="cta-row" style="margin-top: 34px;">
          <a class="btn btn-primary" href="#">
            Shop All Jars{" "}
            <span class="stub" style="color:#FFF6F2;border-color:#FFF6F2">
              Square link
            </span>
          </a>
        </div>
      </div>
    </section>

    <section id="find">
      <div class="shell">
        <div class="sec-head">
          <p class="eyebrow">Come see us</p>
          <h2>Where to find us</h2>
          <p class="lede">
            Lurking at markets and community events around Elgin and Central
            Texas most weekends. You'll know the booth when you see it.
          </p>
        </div>

        <div class="split">
          <div class="cal-stub">
            <Schedule events={catalog.events} />
            <p class="cal-note">
              Paula adds dates in the same spreadsheet as the products.
            </p>
          </div>
          <span class="snapshot">
            <span class="snapshot-paper">
              <img
                src="/images/booth.jpg"
                width="1400"
                height="1050"
                loading="lazy"
                decoding="async"
                alt="The Paula and Crazy John's booth set up under a canopy with red tables full of jars"
              />
            </span>
          </span>
        </div>
      </div>
    </section>

    <section class="story">
      <div class="shell">
        <div class="split">
          <div>
            <p class="eyebrow">Our story</p>
            <p class="story-quote">
              Most of what goes in the jar came out of our own garden.
            </p>
            <span class="snapshot snapshot-story">
              <span class="snapshot-paper">
                <img
                  src="/images/pepper-mash.jpg"
                  width="520"
                  height="339"
                  loading="lazy"
                  decoding="async"
                  alt="Minced red peppers and seeds, part way through a batch of hot sauce"
                />
              </span>
            </span>
          </div>
          <div class="story-body">
            <p>
              <span class="stub">
                Placeholder, two minutes on a voice memo and we'll write this
                properly
              </span>
            </p>
            <p>
              Paula and Crazy John have been putting up salsa, hot sauce, pickles
              and cowboy candy out of a home kitchen in Elgin, Texas, growing
              most of the peppers and produce themselves. What started as too
              much of a garden harvest turned into a booth, and the booth turned
              into a following.
            </p>
            <p>
              Everything is made in small batches under the Texas Cottage Food
              Law, jarred and labeled by hand, and sold face to face at markets
              across Central Texas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="write">
      <div class="shell">
        <div class="sec-head">
          <p class="eyebrow">Write us</p>
          <h2>Leave a note</h2>
          <p class="lede">
            Orders, questions, or something you want put in a jar. We read every
            one. If the wire is down, call or find us on Facebook.
          </p>
        </div>

        <noscript>
          <p class="lede">
            <b>This form needs JavaScript.</b> Call
            <a href="tel:+15126619723">(512) 661-9723</a> or message them on
            <a href="https://www.facebook.com/paulassalsa">Facebook</a> instead -
            that is also where the market dates go up.
          </p>
        </noscript>

        <div class="write-grid" data-list-closed>
          <form class="write-form" id="contact-form">
            <label for="contact-name">
              Name
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="100"
              />
            </label>
            <label for="contact-email">
              Email
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="254"
              />
            </label>
            <label for="contact-message">
              Message
              <textarea id="contact-message" name="message" required maxlength="2000"></textarea>
            </label>
            <label class="write-honeypot" aria-hidden="true">
              Company
              <input type="text" name="company" tabindex="-1" autocomplete="off" />
            </label>
            <button class="btn btn-primary" type="submit">Send it</button>
            <p class="write-status" id="contact-status" role="status" aria-live="polite" tabindex="-1"></p>
          </form>

          <div id="list-box" hidden>
            <p class="eyebrow">The list</p>
            <h2 style="font-size:clamp(24px,3.4vw,32px)">Join the list</h2>
            <p class="lede" style="margin-top:10px">
              We write when there is something to say. It may be a while. You
              will get a confirm email first.
            </p>
            <form class="write-form" id="subscribe-form" style="margin-top:18px">
              <label for="subscribe-email">
                Email
                <input
                  id="subscribe-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  required
                  maxlength="254"
                />
              </label>
              <label class="write-honeypot" aria-hidden="true">
                Company
                <input type="text" name="company" tabindex="-1" autocomplete="off" />
              </label>
              <button class="btn btn-primary" type="submit">Put me on it</button>
              <p
                class="write-status"
                id="subscribe-status"
                role="status"
                aria-live="polite"
                tabindex="-1"
              >
              </p>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" is:inline slot="head">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Paula and Crazy John's Hot Stuff",
      "description": "Small-batch salsa, hot sauce, cowboy candy, pickles and chow chow, made from home grown ingredients in Elgin, Texas under the Texas Cottage Food Law.",
      "url": "https://hotstuff.rwickliffe.workers.dev",
      "image": "https://hotstuff.rwickliffe.workers.dev/images/logo.jpg",
      "telephone": "+1-512-661-9723",
      "priceRange": "$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Elgin",
        "addressRegion": "TX",
        "postalCode": "78621",
        "addressCountry": "US"
      },
      "areaServed": {
        "@type": "GeoCircle",
        "geoMidpoint": { "@type": "GeoCoordinates", "latitude": 30.3494, "longitude": -97.3703 },
        "geoRadius": "60000"
      },
      "sameAs": ["https://www.facebook.com/paulassalsa"],
      "knowsAbout": ["salsa", "hot sauce", "cowboy candy", "pickles", "chow chow"]
    }
  </script>
</Base>
