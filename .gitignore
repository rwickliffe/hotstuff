# Original photos. Kept locally, regenerate public/images/ from them with the
# command in the README. These are Facebook downloads and get replaced by
# camera-roll originals from Paula and John before launch.
source/

# Astro / Wrangler build output. Regenerated by `astro build` (and similar);
# after phase 4, assets.directory points here — still never commit it.
dist/

# Astro generated types (`astro sync` / language tools)
.astro/

# Local secrets for `wrangler dev` (RESEND_*, etc.). Public repo — never commit.
.dev.vars
.dev.vars.*
.env
.env.production

# Package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local review copies of earlier drafts, plus the page that links them.
# Git history is the real version record once this is committed.
baseline/
versions.html

# Generated by tools/test-integrations.sh (under public/ after the host move)
public/integration-test.html
public/integration-site.js
public/_fixtures/

# Editor and tooling
.claude/
.vscode/
.idea/

# macOS
.DS_Store

# Python bytecode, from importing build-horror.py in tests
__pycache__/

# Client account / build notes. Public repo; keep this off GitHub.
ops.md

# Working plans. The README is the docs; these change faster than the site.
plans/

# Wrangler local state (Worker subdir today; root once wrangler moves up)
.wrangler/
worker/.wrangler/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Dev dependencies: the type checker and the Workers runtime types. Nothing
# here ships - the site is static files and wrangler bundles the Worker.
node_modules/
worker/node_modules/
