#!/bin/bash
# Every check in the repo, in one command. Quiet unless something fails.
#
#   ./check
#
# Exits non-zero if any step fails, so it works as a pre-push habit or in CI.
# Nothing here touches the network: the suites stub fetch, and the integration
# script only rewrites the sheet URLs to local fixtures.
set -uo pipefail
cd "$(dirname "$0")"

failed=0

step () {
  local name="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  ok    %s\n' "$name"
  else
    printf '  FAIL  %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/        /'
    failed=1
  fi
}

# The page script is inlined, so pull it out before handing it to node.
page_js () {
  # needs a .js suffix or node reads it as an ES module
  local tmp="${TMPDIR:-/tmp}/hotstuff-page.$$.js"
  awk '/<script>/{f=1;next} /<\/script>/{f=0} f' index.html > "$tmp"
  node --check "$tmp"
  local rc=$?
  rm -f "$tmp"
  return $rc
}

# The stylesheet lives beside the page, and every asset it references is a
# data: URI rather than a second file, so the art costs no request of its own
# and there are no relative paths to break when a page moves. It says nothing
# about the photos or the fonts, which the page still fetches.
stylesheet () {
  grep -q '<link rel="stylesheet" href="styles.css">' index.html ||
    { echo "index.html does not link styles.css"; return 1; }
  local stray
  # The generated block writes url("data:..."), so allow either quoting.
  stray=$(grep -o 'url([^)]*' styles.css | grep -vE 'url\(["'"'"']?data:') || true
  [ -z "$stray" ] ||
    { printf 'styles.css reaches outside itself:\n%s\n' "$stray"; return 1; }
}

step "page script parses"   page_js
step "worker parses"        node --check worker/src/worker.js
step "generated art is current" tools/make-assets.py --check
step "stylesheet is self-contained" stylesheet
# Name the files rather than the directories they sit in: passing a
# directory to --test is not handled the same way across Node versions,
# and CI runs an older one than this machine.
step "unit tests"           node --test tools/test-parsing.mjs worker/test-worker.mjs
step "sheet integration"    tools/test-integrations.sh

if [ "$failed" -ne 0 ]; then
  printf '\n  something above failed\n'
  exit 1
fi
printf '\n  all checks passed\n'
