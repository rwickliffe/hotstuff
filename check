#!/bin/bash
# Every check in the repo, in one command. Quiet unless something fails.
#
#   ./check
#
# Exits non-zero if any step fails, so it works as a pre-push habit or in CI.
# Nothing here touches the network: the suites stub fetch. `astro build` is
# local compile only.
set -uo pipefail
cd "$(dirname "$0")"

failed=0

# node --check cannot read TypeScript: it parses a .ts file as CommonJS and
# trips on the first export. The type checker does both jobs instead. It is the
# one step that needs an install, so it is skipped rather than failed on a
# fresh clone - running ./check has never required fetching anything.
tsc=node_modules/.bin/tsc
astro=node_modules/.bin/astro
if [ ! -x "$tsc" ]; then
  printf '  note  typescript not installed, skipping the type check (npm install)\n'
fi

step () {
  local name="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  ok    %s\n' "$name"
  else
    printf '  FAIL  %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/        /'
    failed=1
  fi
}

page_types () {
  [ -x "$tsc" ] || return 0
  "$tsc" --noEmit --project tsconfig.site.json
}

worker_types () {
  [ -x "$tsc" ] || return 0
  "$tsc" --noEmit --project tsconfig.worker.json
}

# The worker reads the catalog once and leaves it on the ExecutionContext,
# which the Cloudflare adapter passes to pages as locals.cfContext. Rename
# that in the adapter and every page silently falls back to a second KV
# read — which can land on an older copy and file stale HTML under the new
# cache key. Nothing else would fail, so this is the canary.
#
# Match the colon, not the bare word: the same file names the property in a
# deprecation string, so grepping for `cfContext` stays green through exactly
# the rename this is here to catch. The colon is assignment syntax, and it
# survives the adapter minifying its own variable names.
adapter_context () {
  local d=node_modules/@astrojs/cloudflare
  [ -d "$d" ] || return 0
  local f=$d/dist/utils/cf-helpers.js
  [ -f "$f" ] ||
    { echo "the adapter moved cf-helpers.js; check how it builds locals"; return 1; }
  grep -q "cfContext:" "$f" ||
    { echo "the adapter no longer assigns locals.cfContext"; return 1; }
}

pages () {
  grep -q 'href="/styles.css"' src/layouts/Base.astro ||
    { echo "Base.astro does not link /styles.css"; return 1; }
  grep -q 'src="/site.js"' src/layouts/Base.astro ||
    { echo "Base.astro does not load /site.js as a module"; return 1; }
  local stray
  stray=$(grep -o 'url([^)]*' public/styles.css | grep -vE 'url\(["'"'"']?data:') || true
  [ -z "$stray" ] ||
    { printf 'styles.css reaches outside itself:\n%s\n' "$stray"; return 1; }
}

# The favicon carries its own copy of the flame path. It has to: a standalone
# icon needs a baked-in fill to render at all, and the sprite must not have one
# or the heat pips cannot take their colour from the stylesheet. Two copies of
# one shape is the price of that, so check they have not drifted. Anchor the
# match on a space, or id="i-flame" answers to d=" as well.
flame () {
  local sprite icon
  sprite=$(grep -o ' d="[^"]*"' public/flame.svg | sed 's/^ d="//; s/"$//')
  [ -n "$sprite" ] || { echo "no path found in flame.svg"; return 1; }
  icon=$(grep -o " d='[^']*'" src/layouts/Base.astro | head -1 | sed "s/^ d='//; s/'$//")
  [ "$icon" = "$sprite" ] ||
    { echo "the favicon in Base.astro has drifted from flame.svg"; return 1; }
}

# Committed floor for empty KV. Cron does not update this file.
snapshot () {
  local file=data/catalog-snapshot.json
  [ -f "$file" ] || { echo "missing $file — run tools/pull-catalog.mjs"; return 1; }
  node -e '
    const d = JSON.parse(require("fs").readFileSync("data/catalog-snapshot.json", "utf8"));
    if (!Array.isArray(d.products) || d.products.length < 1) {
      console.error("catalog snapshot has no products");
      process.exit(1);
    }
  '
}

csp () {
  node --input-type=module -e '
    import fs from "node:fs";
    import { SITE_CSP } from "./src/lib/csp.ts";
    const headers = fs.readFileSync("public/_headers", "utf8");
    const m = headers.match(/Content-Security-Policy:\s*(.+)/);
    const fromHeaders = (m?.[1] || "").trim();
    if (fromHeaders !== SITE_CSP) {
      console.error("public/_headers CSP does not match SITE_CSP");
      console.error("  _headers:", fromHeaders);
      console.error("  SITE_CSP:", SITE_CSP);
      process.exit(1);
    }
  '
}

site_astro_types () {
  [ -x "$astro" ] || return 0
  [ -d node_modules/@astrojs/check ] || return 0
  "$astro" check
}

site_build () {
  [ -x "$astro" ] || return 0
  "$astro" build
}

# A preview shares nothing with production only if its KV id and rate-limit
# namespace ids differ from the top-level ones, and the adapter flattens the
# config in memory, so look at what it wrote rather than at wrangler.jsonc.
# Copying a production id into `previews` is silent: it would write the live
# catalog, or let a public preview URL rate-limit the live forms. Runs after
# the build for that reason.
previews_isolated () {
  local f=dist/server/wrangler.json
  [ -f "$f" ] || return 0
  node -e '
    const c = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    const p = c.previews;
    if (!p) throw new Error("previews block missing from the built config");
    const ids = (o, k, f) => (o[k] || []).map(f);
    const pairs = [
      ["kv", ids(c, "kv_namespaces", (b) => b.id), ids(p, "kv_namespaces", (b) => b.id)],
      ["ratelimit", ids(c, "ratelimits", (b) => b.namespace_id), ids(p, "ratelimits", (b) => b.namespace_id)],
    ];
    for (const [what, prod, prev] of pairs) {
      if (!prev.length) throw new Error("previews has no " + what + " ids");
      const shared = prev.filter((id) => prod.includes(id));
      if (shared.length) throw new Error("preview reuses production " + what + " ids: " + shared);
    }
  ' "$f"
}

# JS/TS/Astro/JSON only. Python and this script are out of scope.
prettier_check () {
  [ -x node_modules/.bin/prettier ] || return 0
  node_modules/.bin/prettier --check "**/*.{js,ts,mjs,astro,json}"
}

lib_parses () {
  for f in src/lib/csv.js src/lib/grid.js src/domain/heat-scale.js; do
    node --check "$f" || return 1
  done
}

step "page script parses"   node --check public/site.js
step "hand-written modules parse" lib_parses
step "page types"           page_types
step "worker types"         worker_types
step "generated art is current" tools/make-assets.py --check
step "catalog snapshot has products" snapshot
step "SITE_CSP matches _headers" csp
step "pages are wired up"       pages
step "adapter still hands over the context" adapter_context
step "favicon matches the sprite" flame
# Name the files rather than the directories they sit in: passing a
# directory to --test is not handled the same way across Node versions,
# and CI runs an older one than this machine. The shell expands these
# globs to the file list before node sees it, so the constraint holds
# while a new test file still cannot be left out of the gate by accident
# — which is how two suites were added without ever running.
unit_tests () {
  node --test test/lib/*.test.mjs test/domain/*.test.mjs test/worker/*.test.mjs
}
step "unit tests"       unit_tests
step "astro check"          site_astro_types
step "astro build"          site_build
step "previews share nothing with production" previews_isolated
step "prettier"             prettier_check

if [ "$failed" -ne 0 ]; then
  printf '\n  something above failed\n'
  exit 1
fi
printf '\n  all checks passed\n'
