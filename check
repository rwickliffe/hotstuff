#!/bin/bash
# Every check in the repo, in one command. Quiet unless something fails.
#
#   ./check
#
# Exits non-zero if any step fails, so it works as a pre-push habit or in CI.
# Nothing here touches the network: the suites stub fetch, and the integration
# script only rewrites the sheet URLs to local fixtures.
set -uo pipefail
cd "$(dirname "$0")"

failed=0

# node --check cannot read TypeScript: it parses a .ts file as CommonJS and
# trips on the first export. The type checker does both jobs instead. It is the
# one step that needs an install, so it is skipped rather than failed on a
# fresh clone - running ./check has never required fetching anything.
tsc=node_modules/.bin/tsc
if [ ! -x "$tsc" ]; then
  printf '  note  typescript not installed, skipping the type check (npm install)\n'
fi

step () {
  local name="$1"; shift
  local out
  if out=$("$@" 2>&1); then
    printf '  ok    %s\n' "$name"
  else
    printf '  FAIL  %s\n' "$name"
    printf '%s\n' "$out" | sed 's/^/        /'
    failed=1
  fi
}

# Both pages have to reach the shared stylesheet and the shared script, and
# every asset the stylesheet references has to be a data: URI rather than a
# second file, so the art costs no request of its own. It says nothing about
# the photos or the fonts, which the pages still fetch.
page_types () {
  [ -x "$tsc" ] || return 0
  "$tsc" --noEmit --project tsconfig.json
}

worker_types () {
  [ -x "$tsc" ] || return 0
  "$tsc" --noEmit --project worker/tsconfig.json
}

pages () {
  local page
  for page in index.html products.html; do
    grep -q '<link rel="stylesheet" href="styles.css">' "$page" ||
      { echo "$page does not link styles.css"; return 1; }
    grep -q '<script type="module" src="site.js"></script>' "$page" ||
      { echo "$page does not load site.js as a module"; return 1; }
  done
  local stray
  # The generated block writes url("data:..."), so allow either quoting.
  stray=$(grep -o 'url([^)]*' styles.css | grep -vE 'url\(["'"'"']?data:') || true
  [ -z "$stray" ] ||
    { printf 'styles.css reaches outside itself:\n%s\n' "$stray"; return 1; }
}

# The favicon carries its own copy of the flame path. It has to: a standalone
# icon needs a baked-in fill to render at all, and the sprite must not have one
# or the heat pips cannot take their colour from the stylesheet. Two copies of
# one shape is the price of that, so check they have not drifted. Anchor the
# match on a space, or id="i-flame" answers to d=" as well.
flame () {
  local sprite page icon
  sprite=$(grep -o ' d="[^"]*"' flame.svg | sed 's/^ d="//; s/"$//')
  [ -n "$sprite" ] || { echo "no path found in flame.svg"; return 1; }
  for page in index.html products.html; do
    icon=$(grep -o " d='[^']*'" "$page" | head -1 | sed "s/^ d='//; s/'$//")
    [ "$icon" = "$sprite" ] ||
      { echo "the favicon in $page has drifted from flame.svg"; return 1; }
  done
}

step "page script parses"   node --check site.js
step "lib modules parse"    node --check lib/data.js
step "render module parses" node --check lib/render.js
step "page types"           page_types
step "worker types"         worker_types
step "generated art is current" tools/make-assets.py --check
step "baked catalog is current" tools/make-catalog.mjs --check
step "pages are wired up"       pages
step "favicon matches the sprite" flame
# Name the files rather than the directories they sit in: passing a
# directory to --test is not handled the same way across Node versions,
# and CI runs an older one than this machine.
step "unit tests"           node --test tools/test-parsing.mjs worker/test-worker.mjs
step "sheet integration"    tools/test-integrations.sh

if [ "$failed" -ne 0 ]; then
  printf '\n  something above failed\n'
  exit 1
fi
printf '\n  all checks passed\n'
