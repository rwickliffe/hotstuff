{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/env.d.ts",
    "src/site-config.ts",
    "src/**/*.astro",
    "src/lib/**/*.ts",
    "src/lib/**/*.js",
    "src/worker/catalog.ts",
    "src/worker/env.d.ts",
    "src/worker/worker-configuration.d.ts",
    "data/catalog-snapshot.json"
  ]
}
