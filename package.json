{
  "name": "hotstuff",
  "private": true,
  "type": "module",
  "description": "Paula and Crazy John's Hot Stuff — Astro on Cloudflare Workers.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "types": "wrangler types --include-runtime false",
    "check:types": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project src/worker/tsconfig.json"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.2"
  },
  "allowScripts": {
    "workerd@1.20260915.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true
  }
}
